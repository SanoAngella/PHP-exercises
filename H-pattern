<body>
    <h2>Alphabet Pattern 'H'</h2>

    <pre>
<?php
for ($row = 0; $row < 7; $row++) {
    
    if ($row == 3) {
        echo "*****"; 
    } 

    else {
        echo "*  *"; 
    }
    
    echo "\n"; 
}
?>
    </pre>

</body>
